# GadgetLens Environment Configuration
# Copy this file to .env and adjust variables as needed.

# MySQL Database Configuration (Default)
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gadgetlens

# Optional: Direct database URL override (e.g. SQLite for local lightweight testing)
# DATABASE_URL=sqlite:///gadgetlens.db
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/gadgetlens

# Flask Security Secret Key
SECRET_KEY=replace_with_a_long_random_secret_key_in_production
FLASK_ENV=development
